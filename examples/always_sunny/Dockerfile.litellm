# LiteLLM's proxy, with this repository's guardrail for it installed.
# Built from the repository root.
FROM ghcr.io/astral-sh/uv:0.12.23@sha256:61d393e44e249f2e4b526b6c7ddcecce245946826e608e11c93ad4f5bba55b21 AS uv

FROM python:3.13-slim@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /guardrail
COPY src/proxies/litellm ./
# a LiteLLM image of your own would get the guardrail from
# `pip install inspect_sentinel_litellm`
RUN uv pip install \
        --system \
        "litellm[proxy]==1.105.0" \
        .

EXPOSE 4000
ENTRYPOINT ["litellm", "--host", "0.0.0.0", "--port", "4000", "--config", "/config/litellm.yaml"]
