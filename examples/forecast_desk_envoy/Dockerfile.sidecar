# The sidecar, with its Envoy shim and what it needs to read Anthropic's and
# OpenAI's traffic. Built from the repository root.
FROM ghcr.io/astral-sh/uv:0.12.23@sha256:61d393e44e249f2e4b526b6c7ddcecce245946826e608e11c93ad4f5bba55b21 AS uv

FROM python:3.13-slim@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0

# inspect-ai and inspect-scout are installed from their git repositories
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        git \
 && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /src
# inspect-ai's and inspect-scout's main, as development installs them
# (CONTRIBUTING.md), and before the version below, which would otherwise be
# theirs too
RUN uv venv /src/.venv \
 && uv pip install --python /src/.venv/bin/python \
        git+https://github.com/UKGovernmentBEIS/inspect_ai.git \
        git+https://github.com/meridianlabs-ai/inspect_scout.git
# the package takes its version from git, which stays out of the image
ENV SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0
COPY pyproject.toml README.md ./
COPY src ./src
RUN uv pip install --python /src/.venv/bin/python ".[anthropic,envoy,openai]"
ENV PATH=/src/.venv/bin:$PATH
# the example's rule, which the sentinel names as desk_rules/forecast_desk
COPY examples/forecast_desk_envoy/rule /rule
RUN uv pip install --python /src/.venv/bin/python --no-deps /rule

# 8900 for the sidecar's endpoints, 8902 for the Envoy shim
EXPOSE 8900 8902
# the ports and the address are in the sentinel file's server stanza
ENTRYPOINT ["python", "-m", "inspect_sentinel.sidecar"]
