      "description": "What the sidecar stored.",
      "properties": {
        "eval_id": {
          "title": "Eval Id",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        },
        "samples": {
          "description": "How many samples were registered.",
          "title": "Samples",
          "type": "integer"
        },
        "expiry": {
          "description": "How long the registration is kept once no request has named the task, in seconds: what was asked, or less if the sidecar keeps none that long.",
          "title": "Expiry",
          "type": "number"
        }
      },
      "required": [
        "eval_id",
        "task",
        "samples",
        "expiry"
      ],
      "title": "RegisterTaskResult",
      "type": "object"
    },
    "RequestResultParams": {
      "description": "Parameters of `request_result`: one model request, by the eval's id for it.",
      "properties": {
        "id": {
          "description": "The request's `x-irid`.",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "RequestResultParams",
      "type": "object"
    },
    "RequestResultResult": {
      "description": "What happened to the request. With `dropped` or `unknown` records, nothing else is said.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "records": {
          "description": "`held` if the sidecar has the request's records, `dropped` if it had them and no longer keeps them, `unknown` if it never saw the request.",
          "enum": [
            "held",
            "dropped",
            "unknown"
          ],
          "title": "Records",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "judging",
                "awaiting_reply",
                "decided",
                "not_judged"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the latest attempt stands.",
          "title": "State"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "unreadable",
                "unregistered",
                "time_limit",
                "error",
                "provider_error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the latest attempt was not judged.",
          "title": "Reason"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "proceed",
                "reject",
                "terminate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the latest attempt came to, once decided.",
          "title": "Outcome"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the model is told, for a rejection.",
          "title": "Message"
        },
        "recorded": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What each monitor and protocol recorded, every attempt's in order.",
          "title": "Recorded"
        },
        "withheld": {
          "anyOf": [
            {
              "$ref": "#/$defs/WithheldTurn"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The model's turn, when the latest attempt was refused it because a call in it was rejected, as the `sentinel` field holds it. An eval puts it into its own copy of the conversation, as it would from the field."
        },
        "proposed": {
          "anyOf": [
            {
              "$ref": "#/$defs/WithheldTurn"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The model's turn as it proposed it, when the latest attempt was handed it with calls taken out because they were rejected, as the `sentinel` field holds it."
        }
      },
      "required": [
        "id",
        "records"
      ],
      "title": "RequestResultResult",
      "type": "object"
    },
    "RunResultParams": {
      "description": "Parameters of `run_result`: a run, before its sample is scored.",
      "properties": {
        "run": {
          "description": "The run: its sample's uuid.",
          "title": "Run",
          "type": "string"
        }
      },
      "required": [
        "run"
      ],
      "title": "RunResultParams",
      "type": "object"
    },
    "RunResultResult": {
      "description": "What the run came to, and the sentinel's store.",
      "properties": {
        "run": {
          "title": "Run",
          "type": "string"
        },
        "outcome": {
          "description": "`terminate` if a sentinel ended the run.",
          "enum": [
            "proceed",
            "terminate"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "store": {
          "additionalProperties": true,
          "description": "The sentinel's store, by the keys the sentinel wrote, to copy into the sample's store.",
          "title": "Store",
          "type": "object"
        }
      },
      "required": [
        "run",
        "outcome",
        "store"
      ],
      "title": "RunResultResult",
      "type": "object"
    },
    "SampleFacts": {
      "description": "One sample of a registered task.",
      "properties": {
        "sample_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "description": "The sample's id in the dataset.",
          "title": "Sample Id"
        },
        "sample_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
