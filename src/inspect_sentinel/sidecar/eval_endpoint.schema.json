  "title": "Inspect Sentinel: the endpoint for evals",
  "description": "JSON-RPC 2.0 methods, POSTed to /sentinel/v1, with a probe at GET /sentinel/info. `methods` names the definitions that a method's `params` and `result` fit. `errors` lists the codes of the method errors of the endpoint's own.",
  "methods": {
    "register_task": {
      "params": {
        "$ref": "#/$defs/RegisterTaskParams"
      },
      "result": {
        "$ref": "#/$defs/RegisterTaskResult"
      }
    },
    "request_result": {
      "params": {
        "$ref": "#/$defs/RequestResultParams"
      },
      "result": {
        "$ref": "#/$defs/RequestResultResult"
      }
    },
    "run_result": {
      "params": {
        "$ref": "#/$defs/RunResultParams"
      },
      "result": {
        "$ref": "#/$defs/RunResultResult"
      }
    },
    "end_run": {
      "params": {
        "$ref": "#/$defs/EndRunParams"
      },
      "result": {
        "$ref": "#/$defs/EndRunResult"
      }
    }
  },
  "errors": {
    "-32001": {
      "name": "registration_refused",
      "description": "The sidecar takes no registration of this task: it was registered beforehand, or the sidecar takes no registrations from evals."
    },
    "-32002": {
      "name": "unknown_run",
      "description": "The sidecar holds nothing for the run, so an eval never mistakes a forgotten run for a clean one."
    }
  }
}
