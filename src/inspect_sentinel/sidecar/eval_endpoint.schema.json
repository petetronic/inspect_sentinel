    "CompleteRegistrationParams": {
      "description": "Parameters of `complete_registration`: one sample of a registered task, sent before the sample's first epoch.",
      "properties": {
        "sample_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "description": "The sample's id in the dataset.",
          "title": "Sample Id"
        },
        "sample_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What is distinctive about the sample.",
          "title": "Sample Description"
        },
        "sample_input": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ChatMessageSystem"
                  },
                  {
                    "$ref": "#/$defs/ChatMessageUser"
                  },
                  {
                    "$ref": "#/$defs/ChatMessageAssistant"
                  },
                  {
                    "$ref": "#/$defs/ChatMessageTool"
                  }
                ]
              },
              "type": "array"
            }
          ],
          "description": "The sample's input: a string, or chat messages as inspect_ai writes them.",
          "title": "Sample Input"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "The sample's metadata.",
          "title": "Metadata",
          "type": "object"
        },
        "eval_id": {
          "description": "The eval's id, as its requests name it.",
          "title": "Eval Id",
          "type": "string"
        },
        "task": {
          "description": "The task's name, as `register_task` gave it.",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "sample_input",
        "eval_id",
        "task"
      ],
      "title": "CompleteRegistrationParams",
      "type": "object"
    },
    "CompleteRegistrationResult": {
      "description": "That the sample's facts were stored, or that the task was registered beforehand and nothing was stored.",
      "properties": {
        "eval_id": {
          "title": "Eval Id",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        },
        "sample_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Sample Id"
        },
        "fixed": {
          "description": "Whether the task was registered beforehand, in the tasks folder. Its sentinel is then given the folder's facts, the sample is not compared with them, and nothing is stored.",
          "title": "Fixed",
          "type": "boolean"
        }
      },
      "required": [
        "eval_id",
        "task",
        "sample_id",
        "fixed"
      ],
      "title": "CompleteRegistrationResult",
      "type": "object"
    },
