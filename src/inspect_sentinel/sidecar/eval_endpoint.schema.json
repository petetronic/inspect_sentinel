    "RegisterTaskParams": {
      "description": "Parameters of `register_task`: a task an eval runs, and its samples, sent at task init.",
      "properties": {
        "task": {
          "description": "The task's name.",
          "title": "Task",
          "type": "string"
        },
        "task_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What agents in the task are asked to do.",
          "title": "Task Description"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "The task's metadata. A sentinel is given it merged with each sample's own.",
          "title": "Metadata",
          "type": "object"
        },
        "samples": {
          "description": "Every sample of the task.",
          "items": {
            "$ref": "#/$defs/SampleFacts"
          },
          "title": "Samples",
          "type": "array"
        },
        "eval_id": {
          "description": "The eval's id, as its requests name it.",
          "title": "Eval Id",
          "type": "string"
        },
        "expiry": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How long to keep the registration once no request has named the task, in seconds. A day if not given.",
          "title": "Expiry"
        }
      },
      "required": [
        "task",
        "samples",
        "eval_id"
      ],
      "title": "RegisterTaskParams",
      "type": "object"
    },
