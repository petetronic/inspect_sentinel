  "title": "Inspect Sentinel: the endpoint for evals",
  "description": "JSON-RPC 2.0 methods, POSTed to /sentinel/v1, with a probe at GET /sentinel/info. `methods` names the definitions that a method's `params` and `result` fit. `errors` lists the codes of the method errors of the endpoint's own.",
  "methods": {
    "register_task": {
      "params": {
        "$ref": "#/$defs/RegisterTaskParams"
      },
      "result": {
        "$ref": "#/$defs/RegisterTaskResult"
      }
    },
    "complete_registration": {
      "params": {
        "$ref": "#/$defs/CompleteRegistrationParams"
      },
      "result": {
        "$ref": "#/$defs/CompleteRegistrationResult"
      }
    },
    "request_result": {
      "params": {
        "$ref": "#/$defs/RequestResultParams"
      },
      "result": {
        "$ref": "#/$defs/RequestResultResult"
      }
    },
    "sample_result": {
      "params": {
        "$ref": "#/$defs/SampleResultParams"
      },
      "result": {
        "$ref": "#/$defs/SampleResultResult"
      }
    },
    "end_sample": {
      "params": {
        "$ref": "#/$defs/EndSampleParams"
      },
      "result": {
        "$ref": "#/$defs/EndSampleResult"
      }
    }
  },
  "errors": {
    "-32001": {
      "name": "registration_refused",
      "description": "The sidecar takes no tasks registered by an eval, and this task was not registered beforehand; or, for `complete_registration`, the sidecar takes only the samples a task's registration names, and this sample isn't one."
    },
    "-32008": {
      "name": "registrations_full",
      "description": "The sidecar keeps as many task registrations as it takes, and takes another once a kept one expires. A failure, not a refusal: the deployment has not said that the task may not run."
    },
    "-32002": {
      "name": "unknown_sample",
      "description": "The sidecar holds nothing for the sample, so an eval never mistakes a forgotten sample for a clean one."
    },
    "-32009": {
      "name": "unknown_task",
      "description": "The sidecar holds no registration of the task by the eval: it was never registered, or is no longer kept. The eval registers the task again, then completes the sample's registration."
    }
  }
}
